<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
  </PropertyGroup>
  <ItemGroup>
    <!-- ASP.NET Core shared framework supplies Diagnostics.HealthChecks APIs -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <!-- OpenTelemetry — aligned to 1.12.x for Azure.Monitor.OpenTelemetry.AspNetCore 1.3.0 -->
    <PackageReference Include="OpenTelemetry" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
    <!-- Post 6 NEW: EventCounter instrumentation — routes .NET runtime counters as OTel metrics -->
    <PackageReference Include="OpenTelemetry.Instrumentation.EventCounters" />
    <!-- Semantic Conventions — compile-time attribute constants (Post 3) -->
    <PackageReference Include="OpenTelemetry.SemanticConventions" />
    <!-- Azure Monitor OTel Distro — activated in Post 2 -->
    <PackageReference Include="Azure.Monitor.OpenTelemetry.AspNetCore" />
    <!-- Serilog — added in Post 2 -->
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Enrichers.Environment" />
    <PackageReference Include="Serilog.Enrichers.Thread" />
    <!-- Health checks + resilience + service discovery -->
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Microsoft.Extensions.ServiceDiscovery" />
  </ItemGroup>
</Project>
